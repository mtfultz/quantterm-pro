# Alpaca Paper Trading API Credentials
# Get these from: https://app.alpaca.markets/paper/dashboard/overview

ALPACA_API_KEY=example
ALPACA_SECRET_KEY=exmaple

# Ollama AI Engine
# Local development: leave as localhost
# Production (Streamlit Cloud): set to your Cloudflare Tunnel URL, e.g. https://ollama.yourdomain.com
OLLAMA_HOST=http://localhost:11434

# Optional: Override default settings
# TICKER=SPY
# POSITION_SIZE=1000
# MIN_AI_CONFIDENCE=0.7
